# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server only. Never expose. Used by the till + public card routes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random chars. Signs the till device session cookie.
TILL_SESSION_SECRET=change-me-to-a-long-random-string-please

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (receipts, birthday + win-back campaigns)
# Leave blank to keep messages queued in the outbox without sending.
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Shared secret for POST /api/messages/drain and /api/jobs/daily (cron)
JOB_SECRET=change-me-too

# ---------------------------------------------------------------------------
# Mobile Money subscription billing (Flutterwave)
# ---------------------------------------------------------------------------
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
